const express = require('express');
const app = express();

app.set('view engine', 'ejs');

app.get('/', (req, res) => {
    const student = {
        name: 'Sujitha',
        course: 'Computer Science',
        marks: 95
    };

    res.render('home', { student: student });
});

app.listen(3000, () => {
    console.log('Server running on port 3000');
});
